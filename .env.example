# RippleReady Environment Variables

# Frontend -> Backend URL (used when frontend is deployed on Vercel)
VITE_API_URL=https://rippleready-backend.onrender.com

# Backend Port (Render sets this dynamically)
PORT=8080

# SQLite Database File Path (Optional, defaults to data/rippleready.db)
SQLITE_DB_PATH=data/rippleready.db
